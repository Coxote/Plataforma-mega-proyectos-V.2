rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasAdminRole() {
      return isSignedIn() && (
        request.auth.token.email == 'coxot35@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role in ['coordinador', 'director_financiero', 'supervisor'])
      );
    }

    function isValidUserProfile(userId) {
      return isOwner(userId) &&
        request.resource.data.id == userId &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.estado == 'pendiente_autenticacion' &&
        request.resource.data.role in [
          'coordinador',
          'supervisor',
          'director_financiero',
          'sac',
          'contents',
          'contentd',
          'proveedor',
          'invitado'
        ] &&
        !('password' in request.resource.data);
    }

    function isLegacyBootstrapProfile(userId) {
      return isOwner(userId) &&
        request.resource.data.id == userId &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.email in [
          'rodrigo@tpp.com',
          'lourdes@tpp.com',
          'maylin@tpp.com',
          'eduardo@tpp.com',
          'edgar@tpp.com',
          'jeremy@tpp.com',
          'noemi@tpp.com',
          'alejandra@tpp.com',
          'fabiola@tpp.com',
          'luis@tpp.com',
          'sofia@tpp.com',
          'proveedor@tpp.com',
          'invitado@tpp.com',
          'coxot35@gmail.com'
        ] &&
        request.resource.data.estado == 'activo' &&
        request.resource.data.role in [
          'coordinador',
          'supervisor',
          'director_financiero',
          'sac',
          'contents',
          'contentd',
          'proveedor',
          'invitado'
        ] &&
        !('password' in request.resource.data);
    }

    // 1. Projects Collection
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && hasAdminRole() && isValidId(projectId);
      allow update: if isSignedIn() && (hasAdminRole() || request.auth.token.email == 'coxot35@gmail.com');
      allow delete: if isSignedIn() && hasAdminRole();
    }

    // 2. Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isValidId(userId) && (isValidUserProfile(userId) || isLegacyBootstrapProfile(userId) || hasAdminRole());
      allow update: if isValidId(userId) &&
        (
          hasAdminRole() ||
          (
            isOwner(userId) &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'role',
              'estado',
              'autenticadoPor',
              'fechaAutenticacion',
              'password'
            ])
          )
        ) &&
        !('password' in request.resource.data);
      allow delete: if isValidId(userId) && hasAdminRole();
    }

    // 3. Clients Directory
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && hasAdminRole() && isValidId(clientId);
    }

    // 4. Planner Tasks
    match /plannerTasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(taskId);
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }
  }
}
