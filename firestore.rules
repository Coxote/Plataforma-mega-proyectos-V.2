rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasAdminRole() {
      return isSignedIn() && (
        request.auth.token.email == 'coxot35@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role in ['coordinador', 'director_financiero', 'supervisor'])
      );
    }

    // 1. Projects Collection
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && hasAdminRole() && isValidId(projectId);
      allow update: if isSignedIn() && (hasAdminRole() || request.auth.token.email == 'coxot35@gmail.com');
      allow delete: if isSignedIn() && hasAdminRole();
    }

    // 2. Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isValidId(userId);
      allow update, delete: if isValidId(userId);
    }

    // 3. Clients Directory
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && hasAdminRole() && isValidId(clientId);
    }

    // 4. Planner Tasks
    match /plannerTasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(taskId);
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }
  }
}
