rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Projects Collection & Subcollections
    match /projects/{projectId} {
      allow read, write: if isValidId(projectId);

      match /timeEntries/{entryId} {
        allow read, write: if isValidId(entryId);
      }
    }

    // Direct Time Entries Collection
    match /timeEntries/{entryId} {
      allow read, write: if isValidId(entryId);
    }

    // 2. Users Collection
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // 3. Clients Directory
    match /clients/{clientId} {
      allow read, write: if isValidId(clientId);
    }

    // 4. Planner Tasks
    match /plannerTasks/{taskId} {
      allow read, write: if isValidId(taskId);
    }

    // 5. Leaves & Vacations
    match /leaves/{leaveId} {
      allow read, write: if isValidId(leaveId);
    }

    // 6. Kudos & Team Recognition
    match /kudos/{kudoId} {
      allow read, write: if isValidId(kudoId);
    }

    // 7. Gamification Document Store
    match /gamification/{docId} {
      allow read, write: if isValidId(docId);
    }

    // Connection testing
    match /test/connection {
      allow read, write: if true;
    }
  }
}
